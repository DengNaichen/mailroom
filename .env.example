GOOGLE_CREDENTIALS=/absolute/path/to/credentials.json
OPENAI_API_KEY=
OPENAI_MODEL=
MAILROOM_POLL_SECONDS=120
MAILROOM_AUTO_CODEX=0
MAILROOM_CODEX_ACTIONS=0
